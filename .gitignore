# Python
__pycache__/
*.pyc
.venv/
server/.env
server/uploads/
# 微信支付商户私钥/证书(绝不入库)
server/certs/

# Flutter / Dart
.dart_tool/
.packages
build/
# Kotlin 编译器守护进程的会话文件,每次 gradle 构建都会新生成
apps/*/android/.kotlin/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
# android/ 与 ios/ 已入库(含手工定制的清单/权限描述/签名/Bundle ID);
# 其余平台目录仍由 flutter create 再生
apps/*/macos/
apps/*/linux/
apps/*/windows/
apps/*/web/
# ⚠️ 这里**不要**再加 apps/*/test/。
#
# 曾经加过,本意大概是挡掉 flutter create 生成的 widget_test.dart 模板,
# 结果连带把真写的测试也挡在仓库外 —— 商家端的小票版式测试在本机跑了
# 很久、还被当成"版式已验证"的依据,而它从来没进过仓库:别人 clone
# 下来没有,CI 也跑不了。
#
# 模板测试该做的是删掉,不是靠 gitignore 藏起来。

# IDE
.idea/
.vscode/
.DS_Store
dist/
/index.html
server/appdist/

# 官网(web/)
web/node_modules/

# 内部运营策略(不公开)
marketing/
server/app_version.txt
# 部署机地址等本机部署参数(不入库)
deploy/.env.deploy
# 生产密钥与证书:只应存在于部署机(样例是 .env.prod.example / frpc.toml.example)。
# 这些路径此前不在 ignore 里 —— 照开城手册在本地准备文件的人一不小心
# 就会把真密钥提交进公开仓库,宁可多挡一层
deploy/.env.prod
deploy/tunnel/frpc.toml
deploy/certs/
deploy/letsencrypt/
deploy/certbot-www/
deploy/wxpay-certs/
# 内部路线图(公开仓不发布)
docs/ROADMAP.md
merchant-web/node_modules/
