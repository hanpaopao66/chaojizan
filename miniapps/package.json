{
  "name": "superz-official-miniapps",
  "private": true,
  "version": "1.0.0",
  "description": "超级赞官方小程序:记事本、2048(也是开发者的参考实现)",
  "type": "module",
  "scripts": {
    "dev:notepad": "vite --mode notepad",
    "dev:2048": "vite --mode 2048",
    "build:notepad": "vite build --mode notepad",
    "build:2048": "vite build --mode 2048",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.11"
  }
}
