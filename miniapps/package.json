{
  "name": "superz-official-miniapps",
  "private": true,
  "version": "1.0.0",
  "description": "超级赞官方小程序:记事本、2048、贪吃蛇、方块消除、扫雷、五子棋、萌兽三路、方块原野、星火牌局、突击时刻、瓜田防线(也是开发者的参考实现)",
  "type": "module",
  "scripts": {
    "dev:notepad": "vite --mode notepad",
    "dev:2048": "vite --mode 2048",
    "dev:snake": "vite --mode snake",
    "dev:blocks": "vite --mode blocks",
    "dev:minesweeper": "vite --mode minesweeper",
    "dev:gomoku": "vite --mode gomoku",
    "dev:critters": "vite --mode critters",
    "dev:sandbox": "vite --mode sandbox",
    "dev:cards": "vite --mode cards",
    "dev:tactical": "vite --mode tactical",
    "build:notepad": "vite build --mode notepad",
    "build:2048": "vite build --mode 2048",
    "build:snake": "vite build --mode snake",
    "build:blocks": "vite build --mode blocks",
    "build:minesweeper": "vite build --mode minesweeper",
    "build:gomoku": "vite build --mode gomoku",
    "build:critters": "vite build --mode critters",
    "build:sandbox": "vite build --mode sandbox",
    "build:cards": "vite build --mode cards",
    "build:tactical": "vite build --mode tactical",
    "typecheck": "tsc --noEmit",
    "typecheck:sandbox": "tsc --noEmit -p tsconfig.sandbox.json",
    "typecheck:cards": "tsc --noEmit -p tsconfig.cards.json",
    "typecheck:tactical": "tsc --noEmit -p tsconfig.tactical.json",
    "test": "node scripts/test.mjs",
    "test:sandbox": "node scripts/test.mjs sandbox",
    "test:cards": "node scripts/test.mjs cards",
    "test:tactical": "node scripts/test.mjs tactical",
    "dev:tower": "vite --mode tower",
    "build:tower": "vite build --mode tower",
    "typecheck:tower": "tsc --noEmit -p tsconfig.tower.json",
    "test:tower": "node scripts/test.mjs tower",
    "meta": "node scripts/check_miniapp_meta.mjs",
    "qa": "node scripts/qa_miniapps.mjs",
    "typecheck:notepad": "tsc --noEmit -p tsconfig.notepad.json",
    "test:notepad": "node scripts/test.mjs notepad",
    "typecheck:2048": "tsc --noEmit -p tsconfig.2048.json",
    "test:2048": "node scripts/test.mjs 2048",
    "typecheck:snake": "tsc --noEmit -p tsconfig.snake.json",
    "test:snake": "node scripts/test.mjs snake",
    "typecheck:blocks": "tsc --noEmit -p tsconfig.blocks.json",
    "test:blocks": "node scripts/test.mjs blocks",
    "typecheck:minesweeper": "tsc --noEmit -p tsconfig.minesweeper.json",
    "test:minesweeper": "node scripts/test.mjs minesweeper",
    "typecheck:gomoku": "tsc --noEmit -p tsconfig.gomoku.json",
    "test:gomoku": "node scripts/test.mjs gomoku"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.11"
  }
}
