{
  "name": "superz-official-miniapps",
  "private": true,
  "version": "1.0.0",
  "description": "超级赞官方小程序:记事本、2048、贪吃蛇、方块消除、扫雷、五子棋、萌兽三路、方块原野、星火牌局、突击时刻(也是开发者的参考实现)",
  "type": "module",
  "scripts": {
    "dev:notepad": "vite --mode notepad",
    "dev:2048": "vite --mode 2048",
    "dev:snake": "vite --mode snake",
    "dev:blocks": "vite --mode blocks",
    "dev:minesweeper": "vite --mode minesweeper",
    "dev:gomoku": "vite --mode gomoku",
    "dev:critters": "vite --mode critters",
    "dev:sandbox": "vite --mode sandbox",
    "dev:cards": "vite --mode cards",
    "dev:tactical": "vite --mode tactical",
    "build:notepad": "vite build --mode notepad",
    "build:2048": "vite build --mode 2048",
    "build:snake": "vite build --mode snake",
    "build:blocks": "vite build --mode blocks",
    "build:minesweeper": "vite build --mode minesweeper",
    "build:gomoku": "vite build --mode gomoku",
    "build:critters": "vite build --mode critters",
    "build:sandbox": "vite build --mode sandbox",
    "build:cards": "vite build --mode cards",
    "build:tactical": "vite build --mode tactical",
    "typecheck": "tsc --noEmit",
    "typecheck:sandbox": "tsc --noEmit -p tsconfig.sandbox.json",
    "typecheck:cards": "tsc --noEmit -p tsconfig.cards.json",
    "typecheck:tactical": "tsc --noEmit -p tsconfig.tactical.json",
    "test": "node scripts/test.mjs",
    "test:sandbox": "node scripts/test.mjs sandbox",
    "test:cards": "node scripts/test.mjs cards",
    "test:tactical": "node scripts/test.mjs tactical"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.11"
  }
}
