{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["notepad/src", "notepad/test", "2048/src", "2048/test", "shared/src", "shared/test",
    "snake/src", "snake/test", "blocks/src", "blocks/test", "minesweeper/src", "minesweeper/test",
    "gomoku/src", "gomoku/test", "../packages/miniapp-sdk/src", "types.d.ts"]
}
