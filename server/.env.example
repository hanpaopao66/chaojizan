# 复制为 .env 后按需修改。
# 生产部署(.env.prod)另有一份样例:deploy/.env.prod.example ——
# 生产比这里多 4 个 compose 层必填变量,少一个起不来。
#
# 应用层没有必填项:每一项都有默认值,不配的功能按注释里写的方式降级。
# 全量配置与默认值的权威定义在 server/app/config.py;
# 12 项外部依赖配没配齐,起服务后跑 deploy/readiness.sh 一目了然。
DATABASE_URL=postgresql+asyncpg://superz:superz@localhost:5432/superz
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# 收款账户等敏感字段的加密钥。留空则从 JWT_SECRET 派生 ——
# 注意:一经使用不可更换,换了历史密文全部解不开。
# 想让「换 JWT_SECRET」和「换加密钥」解耦,首次部署就单独配它。
CRYPTO_KEY=

# 对外访问地址:店铺短链、海报二维码、分享文案都用它拼 URL。
# 自部署必改,否则二维码全都指向官方实例。
PUBLIC_BASE_URL=http://localhost:8000

# ===== 生产必关的开发开关(本地/e2e 保持默认 true)=====
ADMIN_PASSWORD_LOGIN=true   # 生产 false:管理员只能手机验证码登录
MOCK_PAY_ENABLED=true       # 生产 false:封死 /orders/{no}/pay/mock(否则白嫖下单)

# ===== 腾讯位置服务 Key(lbs.qq.com 申请,一把 key 服务端/客户端两处用)=====
# 不配:地址搜索返回演示数据、商家 city 留空不参与多城市隔离、地图无底图。
# 客户端那份在打包时以 --dart-define=TENCENT_MAP_KEY 注入,见 docs/AMAP_SETUP.md
TENCENT_MAP_KEY=

# ===== 对象存储(本地开发默认 local 落磁盘;生产必须 minio)=====
# 切 minio 后连不上是明确 503,绝不静默退回磁盘 —— 证照/留证的隐私靠桶策略保证。
# 注意:这两个 key 是给 api 用的;MinIO 容器本身的 MINIO_ROOT_USER/PASSWORD
# 是另一组变量(见 deploy/.env.prod.example),两组必须手动对齐。
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=superz
MINIO_SECRET_KEY=superz-dev-secret
MINIO_SECURE=false

# ===== 微信支付 V3(不配则 /pay/wechat 返回 503,客户端自动走模拟支付)=====
# 申请与联调步骤(含收付通类目、证书摆放、三个最常见的坑):docs/WXPAY-SETUP.md
WXPAY_APP_ID=
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_CERT_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
WXPAY_NOTIFY_URL=https://你的域名/payments/wechat/notify
# 「微信支付公钥」模式(2024 下半年后新开的商户号默认)才填这两项;
# 老的「平台证书」模式留空,SDK 自动下载并缓存到 certs/platform
WXPAY_PUBLIC_KEY_PATH=
WXPAY_PUBLIC_KEY_ID=

# ===== 极光推送(不配则跳过离线推送,WebSocket 前台通道不受影响)=====
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ===== 阿里云短信(不配则验证码走开发模式:直接返回给客户端)=====
# ⚠️ 生产必配:开发模式等于任何人拿到手机号就能登录任意账号。
# AccessKey 建议用只授「短信发送」权限的 RAM 子账号。
# 签名与模板要用你自己在阿里云审核过的 —— 下面两个默认值是官方实例的,发不出你的短信
SMS_SECRET_ID=            # 阿里云 AccessKey ID
SMS_SECRET_KEY=           # 阿里云 AccessKey Secret(机密,勿入库)
SMS_SIGN_NAME=爱卡斯科技   # 已审核的短信签名(自部署换成你的)
SMS_TEMPLATE_ID=SMS_510415101   # 短信模板 CODE(自部署换成你的)
SMS_TEMPLATE_PARAM=code   # 模板里验证码变量名(${code} 则填 code)
SMS_REGION_ID=cn-hangzhou
# 应用商店审核账号白名单:"手机号:固定码" 逗号分隔,如 13900000001:246810
# 命中的号码不真发短信,登录用固定码即过(海外审核员收不到国内短信)。
# 留空 = 关闭;固定码只放部署机 .env.prod,过审后可清空
SMS_REVIEW_ACCOUNTS=

# ===== 公开经营大屏(/screen)=====
# 演示模式:真实数据上叠加模拟增量,页面明示"演示数据"角标;生产保持 0
SCREEN_DEMO=0

# ===== 更多选配(默认值见 server/app/config.py,不配按注释降级)=====
# ALI_PNP_KEY_ID= / ALI_PNP_KEY_SECRET= / ALI_PNP_POOL_KEY=  号码隐私 AXB 中间号
#   PRIVACY_PHONE_STRICT=false  非严格模式:界面打码但拨打走真号
# IDCHECK_API_URL= / IDCHECK_APP_CODE=  身份证二要素核验(不配只做格式+校验位)
# INSURANCE_APP_ID= / INSURANCE_SECRET=  骑手意外险(不配只登记不投保)
# FLEXWORK_APP_ID= / FLEXWORK_SECRET=  灵活用工打款(不配则 T+1 人工打款)
# FEIE_USER= / FEIE_UKEY=  飞鹅云打印(不配商家仍可蓝牙直连小票机)
# OCR_ENDPOINT=  证照 OCR,接自部署识别服务,契约见 server/app/routers/ocr.py
# MINI_APP_SECRET=  小程序 initData 签名钥(不配从 JWT_SECRET 派生,见 services/mini_app.py)
# GITHUB_REPO=  工程透明页展示用的仓库名(自部署 fork 后改成你的)
