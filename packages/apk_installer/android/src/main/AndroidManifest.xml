<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 自建分发渠道的应用内安装(#123)。
         这是一个敏感权限,三端 manifest 又是为上架整改特意精简过的
         (一排 tools:node="remove")。上架应用商店时,store flavor 的
         AndroidManifest 里用同样的写法把它摘掉:
             <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
                              tools:node="remove"/>
         否则审核一定会问"你为什么需要安装其他应用"——而商店渠道本来
         就禁止绕过审核自更新,那个包也确实不该有这个能力。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application>
        <!-- authority 带 ${applicationId}:三端装在同一台手机上不会撞车 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/superz_apk_paths"/>
        </provider>
    </application>
</manifest>
