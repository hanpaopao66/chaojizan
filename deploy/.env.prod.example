# 生产环境变量样例。复制到部署机为 deploy/.env.prod(不入库,rsync 排除)。
# 用法:docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# 这份文件 = compose 层必填 4 项 + server/.env.example 的应用层配置 + 运维脚本用的几项。
# 完整的部署步骤(按时间顺序,含花多少钱、办什么证):docs/OPEN-A-CITY.md

# ===== compose 层必填(${VAR:?} 强制,缺一个 up 直接报错)=====
# 三个口令分别用 openssl rand 生成(数据库/对象存储 -hex 16,签发钥 -hex 32)。
# ⚠️ 签发钥 JWT_SECRET 首次上线后不可再换 ——
#   收款账户密文默认由它派生加密(除非单独配了 CRYPTO_KEY)
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=superz
MINIO_ROOT_PASSWORD=

# ===== 应用层(注入 superz-api 容器)=====
# 生产两开关必须是 false —— readiness 自检会红灯提醒,但不拦启动
ADMIN_PASSWORD_LOGIN=false
MOCK_PAY_ENABLED=false

# 对象存储:生产必须 minio(local 落容器磁盘,重建即丢)。
# MINIO_ACCESS_KEY/SECRET_KEY 是 api 侧凭据,与上面 ROOT 那组必须一致
# (compose 里 minio-init 用 ROOT 组建桶,api 用这组读写)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=superz-minio:9000
MINIO_ACCESS_KEY=superz
MINIO_SECRET_KEY=           # 与 MINIO_ROOT_PASSWORD 相同
MINIO_SECURE=false

# 对外地址:短链/二维码/分享 URL 的域名,自部署必改
PUBLIC_BASE_URL=https://你的域名

# DATABASE_URL / REDIS_URL 不用写:compose 的 environment 层负责拼接
# 容器内地址(引用上面的 POSTGRES_PASSWORD),优先级高于本文件

# 短信(生产必配,理由见 server/.env.example 同段注释)
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_TEMPLATE_PARAM=code
SMS_REGION_ID=cn-hangzhou

# 地图 / 推送 / 微信支付:见 server/.env.example 对应段落。
# 微信支付证书放部署机 ~/super-z/deploy/wxpay-certs/(chmod 700,scp 上去),
# 容器内挂载为 /srv/certs,所以路径写 certs/xxx.pem(WORKDIR=/srv)
TENCENT_MAP_KEY=
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# WXPAY_APP_ID= ……(全套见 server/.env.example,步骤见 docs/WXPAY-SETUP.md)

# ===== 站内见证节点(compose witness 服务用)=====
# 刻意走公网域名拉账本,不内网直连 —— 和公众跑的是同一条路径
WITNESS_API=https://你的域名
WITNESS_NAME=官方节点
WITNESS_REGION=你的城市

# ===== 运维脚本用(不注入容器)=====
# healthcheck-alert.sh 的告警群机器人(钉钉/企业微信 text 格式通用);
# 不配则告警只写日志 —— 等于没有告警,强烈建议配
WEBHOOK_URL=
# backup.sh 的异地备份目标(user@host:/path);不配则备份只存本机,
# 本机磁盘故障 = 数据和备份一起没
OFFSITE_DEST=
